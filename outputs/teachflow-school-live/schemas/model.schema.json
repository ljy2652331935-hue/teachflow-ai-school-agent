{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teachflow.local/schemas/misconception-diagnosis.schema.json",
  "title": "TeachFlow Misconception Diagnosis Engine",
  "type": "object",
  "required": ["analysis_run_id", "topic", "class_understanding_summary", "student_levels", "misconceptions", "teacher_summary"],
  "properties": {
    "analysis_run_id": { "type": "string" },
    "topic": { "type": "string" },
    "class_understanding_summary": { "type": "string" },
    "student_levels": {
      "type": "object",
      "required": ["confused", "partially_understood", "ready_to_apply"],
      "properties": {
        "confused": {
          "type": "array",
          "items": { "$ref": "#/$defs/StudentAlias" }
        },
        "partially_understood": {
          "type": "array",
          "items": { "$ref": "#/$defs/StudentAlias" }
        },
        "ready_to_apply": {
          "type": "array",
          "items": { "$ref": "#/$defs/StudentAlias" }
        }
      }
    },
    "misconceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/Misconception" }
    },
    "teacher_summary": { "type": "string" }
  },
  "$defs": {
    "StudentAlias": {
      "type": "string",
      "pattern": "^S[0-9]{3}$"
    },
    "Misconception": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "severity",
        "affected_students",
        "evidence_quotes",
        "likely_root_cause",
        "teaching_need",
        "recommended_next_action"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "affected_students": {
          "type": "array",
          "items": { "$ref": "#/$defs/StudentAlias" },
          "minItems": 1
        },
        "evidence_quotes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/EvidenceQuote" }
        },
        "likely_root_cause": { "type": "string" },
        "teaching_need": { "type": "string" },
        "recommended_next_action": { "type": "string" }
      }
    },
    "EvidenceQuote": {
      "type": "object",
      "required": ["student_alias", "quote", "why_it_matters"],
      "properties": {
        "student_alias": { "$ref": "#/$defs/StudentAlias" },
        "quote": { "type": "string" },
        "why_it_matters": { "type": "string" }
      }
    }
  }
}
